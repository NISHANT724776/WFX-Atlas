{
  "name": "wfx-knowledge-hub",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "prebuild": "node scripts/seo-files.mjs && node scripts/export-data.mjs",
    "build": "ng build",
    "postbuild": "node scripts/postbuild.mjs",
    "assets": "node scripts/brand-assets.mjs",
    "preview": "npx serve@14.2.4 dist/wfx-knowledge-hub/browser",
    "watch": "ng build --watch --configuration development",
    "test:ai": "node scripts/test-ai.mjs",
    "test:ask": "node scripts/test-ask.mjs",
    "kb:server": "node --disable-warning=ExperimentalWarning backend/src/server.ts",
    "kb:user": "node --disable-warning=ExperimentalWarning backend/scripts/set-user.ts",
    "kb:migrate": "node --disable-warning=ExperimentalWarning backend/scripts/migrate-v1.mjs",
    "kb:import": "node --disable-warning=ExperimentalWarning backend/scripts/import.ts",
    "kb:reindex": "node --disable-warning=ExperimentalWarning backend/scripts/reindex.ts",
    "kb:registry": "node --disable-warning=ExperimentalWarning backend/scripts/build-registry.ts",
    "kb:capture-prototype": "node --disable-warning=ExperimentalWarning backend/scripts/capture-prototype.ts",
    "kb:ask": "node --disable-warning=ExperimentalWarning backend/scripts/ask.ts",
    "kb:inventory": "node --disable-warning=ExperimentalWarning backend/scripts/inventory.ts",
    "kb:evaluate": "node --disable-warning=ExperimentalWarning backend/scripts/evaluate.ts",
    "kb:enrich": "node --disable-warning=ExperimentalWarning backend/scripts/enrich.ts",
    "kb:export-training": "node --disable-warning=ExperimentalWarning backend/scripts/export-training.ts",
    "kb:import-questions": "node --disable-warning=ExperimentalWarning backend/scripts/import-questions.ts",
    "kb:eval-paraphrase": "node --disable-warning=ExperimentalWarning backend/scripts/eval-paraphrase.ts",
    "kb:typecheck": "tsc -p backend/tsconfig.json",
    "test:kb": "node tests/run.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.29",
    "@anthropic-ai/sdk": "^1.10.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^20.17.19",
    "lucide-static": "^1.75.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.3",
    "typescript": "~5.9.2"
  }
}
