# Optional AI mode (see AI-MODE.md). Set these as environment variables on the host (Vercel: Project Settings > Environment Variables).
# Never put real keys in the repository or in the Angular app.

# Keys: set one or both. A provider with no key is simply not offered.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Default provider when both keys exist: gemini or claude
AI_PROVIDER=gemini

# Models (change when the provider retires or renames a model)
AI_GEMINI_MODEL=gemini-2.5-flash
AI_CLAUDE_MODEL=claude-opus-5-5

# Protection against runaway cost: AI questions per visitor (IP) per hour, per server instance
AI_RATE_LIMIT_PER_HOUR=30

# Switch the whole feature off without removing keys
# AI_ENABLED=0

# Test the widget without any provider or cost
# AI_MOCK=1

# Knowledge server (npm run kb:server): put the key in a file named .env next to package.json (one line: ANTHROPIC_API_KEY=...).
# The server reads it at start. Then an admin records the organisation's approval under Admin › AI provider (choose Claude).
# AI_CLAUDE_MODEL defaults to claude-opus-5-5.
